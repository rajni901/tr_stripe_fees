<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_provider_stripe_fees" model="ir.ui.view">
        <field name="name">payment.provider.stripe.fees</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stripe Fees" name="stripe_fees"
                      invisible="code != 'stripe'">
                    <group>
                        <field name="stripe_fees_active"
                               widget="boolean_toggle"/>
                    </group>
                    <group invisible="not stripe_fees_active">
                        <group string="Domestic Transaction Fees">
                            <field name="stripe_fee_fixed"
                                   string="Fixed Fee ($)"
                                   help="e.g. 0.30 for $0.30 per transaction"/>
                            <field name="stripe_fee_percent"
                                   string="Percentage Fee (%)"
                                   help="e.g. 2.9 for 2.9%"/>
                        </group>
                        <group string="International Transaction Fees">
                            <field name="stripe_intl_fee_fixed"
                                   string="Fixed Fee ($)"/>
                            <field name="stripe_intl_fee_percent"
                                   string="Percentage Fee (%)"
                                   help="e.g. 3.9 for 3.9% (usually higher for international)"/>
                        </group>
                        <group string="Accounting">
                            <field name="stripe_fee_income_account_id"
                                   string="Fee Income Account"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   help="Optional: revenue account for the Stripe fee. When set, the fee appears as a separate credit line on the payment journal entry (Dr Bank = base+fee, Cr Receivable = base, Cr Fee Income = fee). Leave empty to keep the old behaviour (transaction amount inflated, no split entry)."/>
                        </group>
                    </group>
                    <div invisible="not stripe_fees_active"
                         class="alert alert-info" style="margin-top:16px;">
                        <strong>How it works:</strong> When a customer pays with Stripe,
                        the fee is automatically added to their payment amount.
                        Fee = Fixed Fee + (Order Amount × Percentage / 100).
                        International: customer's country ≠ your company's country.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
